#!/bin/sh
# help_gen - generates help.h include file from text file help.txt

/bin/rm -f help.h
/bin/echo \/\* help.h , generated by help_gen from help.txt \*\/ > help.h
/bin/echo static char \*help_txt\[\] = \{ >> help.h
# escape backslashes and double quotes so any help text is a valid C string
sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/^/"/' -e 's/$/",/' help.txt >> help.h
/bin/echo \"%END\" >> help.h
/bin/echo \} \; >> help.h
